{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smp-card-assistant.local/schemas/template.schema.json",
  "title": "SMP Card Assistant template",
  "type": "object",
  "required": ["formatVersion", "id", "name", "type", "sections"],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": ["text-snippet", "medical-card"]
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null"]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
